# direnv / nix dev shell cache
.direnv/

# local logs / binaries, and MSBuild output at any depth
*.log
bin/
obj/

# What `go build ./cmd/<name>` leaves in backend/ when run without -o.
/backend/backend
/backend/discordd
/backend/groupd
/backend/qa
/backend/release
/backend/soak
/backend/watchd

# Core dumps. kernel.core_pattern on the dev machine drops them into the crashed process's directory.
core.[0-9]*

# Everything a task writes under build/: the binaries, the vendored Windows ffmpeg and its license,
# the release tarball and zip, the tree flatpak-builder assembles and the repository it exports through.
/build/

# flatpak-builder's per-module build state.
# CI caches it so ffmpeg is compiled once (.github/workflows/release.yml).
.flatpak-builder/

# What `task relay` draws for a relay on this machine: the certificate its TLS listeners hold,
# the key the group service signs tokens with, and the pair MediaMTX generates for its MoQ
# listener in whatever directory it runs from. Private keys among them, and every one of them is
# drawn again wherever it is absent.
/dev-relay/

# The MoQ pair MediaMTX generates beside itself when started by hand from another directory.
auto.crt
auto.key
