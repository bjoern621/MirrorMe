<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:ti="using:TablerIcons"
             xmlns:model="using:ScreenShare.App.Features.Viewer.Model"
             xmlns:vm="using:ScreenShare.App.Features.Viewer.ViewModel"
             xmlns:view="using:ScreenShare.App.Features.Viewer.View"
             xmlns:tile="using:ScreenShare.App.Features.Viewer.Tile.ViewModel"
             xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
             xmlns:watch="using:ScreenShare.App.Features.Viewer.WatchSettings.View"
             x:Class="ScreenShare.App.Features.Viewer.View.ViewerView"
             x:DataType="vm:ViewerViewModel"
             Background="{StaticResource SurfaceBrush}">

  <UserControl.Styles>
    <!-- A strip cell with no picture: a stopped stream, the Grid switch. -->
    <Style Selector="Border.cell">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}" />
      <Setter Property="Padding" Value="{StaticResource InsetTight}" />
      <Setter Property="Transitions">
        <Transitions>
          <controls:BrushFade Property="Background" Duration="{StaticResource MotionHover}" Easing="{StaticResource MotionEase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover Border.cell">
      <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Border.overpanel">
      <Setter Property="Width" Value="300" />
      <Setter Property="Margin" Value="{StaticResource InsetPanel}" />
      <Setter Property="Padding" Value="{StaticResource InsetPanel}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
      <Setter Property="BoxShadow" Value="{StaticResource MenuShadow}" />
    </Style>
    <Style Selector="Border.overpanel.sheet">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>

    <!-- The panel slides in from the edge it stands against: the right beside the stage, the foot as a sheet. -->
    <Style Selector="Panel[IsVisible=True] > Border.overpanel:not(.sheet)">
      <Style.Animations>
        <Animation Duration="{StaticResource MotionMount}" Easing="{StaticResource MotionEase}">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateX(24px)" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel[IsVisible=True] > Border.overpanel.sheet">
      <Style.Animations>
        <Animation Duration="{StaticResource MotionMount}" Easing="{StaticResource MotionEase}">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(48px)" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <!-- No title bar, no nav strip and no status band, the shell owning all three. -->
  <Grid>

    <DockPanel Margin="{StaticResource InsetPanel}">

      <!--
        Lines under the stage: the members sharing nothing on a stacked strip, and what failed.
        Red without a condition on the refusals: a refusal is a failure and nothing else lands there
        (docs/design-language.md, "Palette").
      -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="{StaticResource GapTight}">
        <ItemsControl ItemsSource="{Binding HintsBelow}" IsVisible="{Binding HasHintsBelow}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="model:MemberHint">
              <TextBlock Classes="hint" Text="{Binding Line}" TextWrapping="Wrap" TextTrimming="None" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <SelectableTextBlock Classes="hint" Text="{Binding Notice}" TextWrapping="Wrap"
                             Classes.danger="{Binding NoticeIsFailure}"
                             IsVisible="{Binding NoticeBelow}" Margin="0,10,0,0" />
        <SelectableTextBlock Classes="hint danger" Text="{Binding Refusal}" TextWrapping="Wrap"
                             IsVisible="{Binding HasRefusal}" Margin="0,10,0,0" />
        <SelectableTextBlock Classes="hint danger" Text="{Binding GroupRefusal}" TextWrapping="Wrap"
                             IsVisible="{Binding HasGroupRefusal}" Margin="0,10,0,0" />
      </StackPanel>

      <Panel>

      <!--
        The sideways bar belongs to the strip: the panel reports the width the strip needs, and the stage is
        placed at the offset so it stands still under the reader's eye while the strip moves
        (Features/Viewer/Model/FocusLayout.cs).
        A stacked strip runs down, and the bar with it.
      -->
      <ScrollViewer Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Strip}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <view:TileGrid Mode="{Binding Mode}"
                             Viewport="{Binding #GridScroll.Viewport}"
                             Offset="{Binding #GridScroll.Offset.X}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerTheme>
            <ControlTheme TargetType="ContentPresenter" x:DataType="model:IStripItem">
              <Setter Property="view:TileGrid.Aspect" Value="{Binding Aspect}" />
              <Setter Property="view:TileGrid.IsFocusedTile" Value="{Binding IsFocused}" />
            </ControlTheme>
          </ItemsControl.ItemContainerTheme>
          <ItemsControl.DataTemplates>

            <!--
              The one host that draws the plate.
              A stream whose picture went elsewhere keeps its slot here, popped out or fullscreen,
              so which of the two a card draws is the host's to state
              (Features/Viewer/Tile/View/TileCard.axaml.cs).
            -->
            <DataTemplate x:DataType="tile:TileViewModel">
              <tiles:TileCard PictureElsewhere="{Binding PictureElsewhere}" InGrid="True"
                              Classes.staged="{Binding IsStaged}"
                              Classes.alone="{Binding StripHidden}"
                              Classes.beside="{Binding !StripHidden}" />
            </DataTemplate>

            <!-- A stopped stream: a press plays it, and its menu opens it outside this window. -->
            <DataTemplate x:DataType="vm:StreamRowViewModel">
              <Button Theme="{StaticResource TileButton}" VerticalContentAlignment="Stretch"
                      Command="{Binding Show}"
                      ToolTip.Tip="{x:Static copy:Cards.PlayAgainTip}"
                      controls:Pending.IsActive="{Binding Show.IsRunning}">
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <!--
                      One item per leg the catalog offered, none greyed.
                      Whether a leg carries this stream is answered against the stream when the viewer opens,
                      and the relay snapshot can be older than the stream.
                    -->
                    <MenuItem Header="Open in player" ItemsSource="{Binding Legs}">
                      <MenuItem.Icon>
                        <ti:TablerIcon Icon="IconPlayerPlay" />
                      </MenuItem.Icon>
                      <!--
                        The tick reads whether the leg is open.
                        A ToggleType would write its own IsChecked on the click, reporting a call the backend
                        has yet to answer.
                      -->
                      <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" x:DataType="vm:WatchLegViewModel"
                                      BasedOn="{StaticResource {x:Type MenuItem}}">
                          <Setter Property="Header" Value="{Binding Label}" />
                          <Setter Property="Command" Value="{Binding Toggle}" />
                          <Setter Property="IsChecked" Value="{Binding IsOpen, Mode=OneWay}" />
                        </ControlTheme>
                      </MenuItem.ItemContainerTheme>
                    </MenuItem>

                    <!--
                      The legs a browser reaches, a set apart from the player's.
                      No tick: a tab belongs to the browser, so this side can neither read whether it is open
                      nor close it.
                    -->
                    <MenuItem Header="Open in browser" ItemsSource="{Binding BrowserLegs}">
                      <MenuItem.Icon>
                        <ti:TablerIcon Icon="IconBrowser" />
                      </MenuItem.Icon>
                      <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" x:DataType="vm:BrowserLegViewModel"
                                      BasedOn="{StaticResource {x:Type MenuItem}}">
                          <Setter Property="Header" Value="{Binding Label}" />
                          <Setter Property="Command" Value="{Binding Open}" />
                        </ControlTheme>
                      </MenuItem.ItemContainerTheme>
                    </MenuItem>

                    <Separator />

                    <!--
                      Printed, never offered.
                      A greyed row in this product reads as an action some configuration took away.
                    -->
                    <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Tracks}" />
                    <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Detail}" />
                    <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Readers}" />
                  </MenuFlyout>
                </Button.ContextFlyout>

                <Border Classes="cell">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="{StaticResource GapTight}">
                    <ti:TablerIcon Classes="button" Icon="IconPlayerPlay" HorizontalAlignment="Center"
                                   Brush="{StaticResource MutedBrush}" />
                    <TextBlock Classes="ident" Text="{Binding Label}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>

            <!-- A member sharing nothing, dashed as every empty place in this app is. -->
            <DataTemplate x:DataType="model:MemberHint">
              <Panel>
                <Rectangle Stroke="{StaticResource DividerBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="4,4"
                           RadiusX="{StaticResource RadiusTileValue}"
                           RadiusY="{StaticResource RadiusTileValue}" />
                <TextBlock Classes="hint" Text="{Binding Line}" Margin="{StaticResource InsetTight}"
                           TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
            </DataTemplate>

            <DataTemplate x:DataType="vm:GridSwitch">
              <Button Theme="{StaticResource TileButton}" VerticalContentAlignment="Stretch"
                      Command="{Binding Toggle}" ToolTip.Tip="{Binding Tip}">
                <Border Classes="cell">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapTight}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ti:TablerIcon Classes="button" Icon="IconLayoutGrid" Brush="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Classes="hint" Text="{x:Static copy:Cards.GridSwitch}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>

      <!--
        The empty state the design language draws: dashed border, muted badge, one sentence,
        nothing to press (docs/design-language.md, "Empty states").
        The sentence is per cause and quiet where the relay notice speaks (Model/GridEmpty.cs).
      -->
      <Grid IsVisible="{Binding ShowsGridEmpty}">
        <Rectangle Stroke="{StaticResource DividerBrush}"
                   StrokeThickness="1"
                   StrokeDashArray="4,4"
                   RadiusX="{StaticResource RadiusTileValue}"
                   RadiusY="{StaticResource RadiusTileValue}" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
          <Border Width="32" Height="32" CornerRadius="16"
                  Background="{StaticResource PanelBrush}"
                  HorizontalAlignment="Center">
            <ti:TablerIcon Classes="button" Icon="IconUsers" Brush="{StaticResource HintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     TextAlignment="Center"
                     Text="{Binding GridEmptyLine}" />
        </StackPanel>
      </Grid>

      <StackPanel MaxWidth="500"
                  Spacing="{StaticResource GapControl}"
                  VerticalAlignment="Center">

        <!--
          What the relay answered, the reader's only account of an unreachable one.
          Red for the backend's own sentence alone.
        -->
        <StackPanel IsVisible="{Binding NoticeCentred}" Spacing="{StaticResource GapTight}">
          <SelectableTextBlock Classes="hint" Text="{Binding Notice}"
                               Classes.danger="{Binding NoticeIsFailure}"
                               TextWrapping="Wrap" TextAlignment="Center" />

          <!-- Under the failure line: a notice about the relay has nothing being dialled behind it. -->
          <controls:Waiting HorizontalAlignment="Center"
                            IsVisible="{Binding IsDialling}"
                            ToolTip.Tip="{x:Static copy:Cards.Redialling}" />

          <!--
            The arc for the answer that is still coming, under the line naming what is being read.
            No tip: that line already says it (docs/design-language.md, "Wording").
          -->
          <controls:Waiting HorizontalAlignment="Center" IsVisible="{Binding IsReading}" />
        </StackPanel>

        <!--
          Outside a group the stage asks the way in (Model/GridEmpty.cs).
          The press leads to the control that sets the picked way, so the setting keeps one editor.
        -->
        <StackPanel IsVisible="{Binding ShowsJoinCard}" Spacing="{StaticResource GapControl}">
          <StackPanel Spacing="4" Margin="0,0,0,6">
            <TextBlock Classes="heading" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                       Text="{x:Static copy:Cards.JoinTitle}" />
            <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                       Text="{x:Static copy:Cards.JoinBody}" />
          </StackPanel>

          <Button Theme="{StaticResource OptionCard}" Classes.picked="{Binding PicksDiscord}" Command="{Binding PickDiscord}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapControl}">
              <ti:TablerIcon Grid.Column="0" Classes="button" Icon="IconBrandDiscord"
                             Brush="{Binding $parent[Button].Foreground, Mode=OneWay}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <WrapPanel ItemSpacing="8" LineSpacing="4">
                  <TextBlock Classes="optiontitle" TextWrapping="Wrap" TextTrimming="None"
                             VerticalAlignment="Center" Text="{x:Static copy:Cards.JoinDiscord}" />
                  <Border Classes="tag" VerticalAlignment="Center">
                    <TextBlock Classes="tag" Text="{x:Static copy:Cards.Recommended}" />
                  </Border>
                </WrapPanel>
                <TextBlock Classes="cardbody" Text="{x:Static copy:Cards.JoinDiscordDetail}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Theme="{StaticResource OptionCard}" Classes.picked="{Binding PicksKey}" Command="{Binding PickKey}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapControl}">
              <ti:TablerIcon Grid.Column="0" Classes="button" Icon="IconKey"
                             Brush="{Binding $parent[Button].Foreground, Mode=OneWay}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="optiontitle" TextWrapping="Wrap" TextTrimming="None" Text="{x:Static copy:Cards.JoinKey}" />
                <TextBlock Classes="cardbody" Text="{x:Static copy:Cards.JoinKeyDetail}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Command="{Binding Join}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapTight}" HorizontalAlignment="Center">
              <ti:TablerIcon Classes="button" Icon="{Binding JoinGlyph}"
                             Brush="{Binding $parent[Button].Foreground, Mode=OneWay}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding JoinLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      </Panel>

    </DockPanel>

    <!--
      The watch settings over the stage, which keeps its whole width (docs/design-language.md, "Narrow windows").
      A panel, never a flyout: a flyout would close on every click.
    -->
    <controls:Overlay IsOpen="{Binding WatchPanel.IsOpen}">
      <Panel>
        <controls:Overlay IsOpen="{Binding WatchPanel.IsSheet}">
          <Border Classes="scrim" PointerPressed="ScrimPressed" />
        </controls:Overlay>
        <Border Classes="overpanel" Classes.sheet="{Binding WatchPanel.IsSheet}">
          <watch:WatchSettingsView DataContext="{Binding Watch}" />
        </Border>
      </Panel>
    </controls:Overlay>

    <!--
      The stream filling this window, over every column: fullscreen is a property of the window and not an
      arrangement of tiles, so the stage goes and the shell takes its bands off the window too
      (Features/Shell/ViewModel/ShellViewModel.cs).

      A TileGrid of one card letterboxes the picture, one definition of a letterbox serving both
      (Features/Viewer/Model/TileLayout.cs).
    -->
    <Panel Background="{StaticResource TileBrush}"
           IsVisible="{Binding HasFullscreen}">
      <ContentControl Content="{Binding FullscreenTile}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="tile:TileViewModel">
            <view:TileGrid>
              <tiles:TileCard view:TileGrid.Aspect="{Binding Aspect}" />
            </view:TileGrid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>

  </Grid>

</UserControl>
