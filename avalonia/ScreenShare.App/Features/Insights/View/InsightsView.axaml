<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chart="using:ScreenShare.App.Features.Insights.Chart.View"
             xmlns:chartvm="using:ScreenShare.App.Features.Insights.Chart.ViewModel"
             xmlns:model="using:ScreenShare.App.Features.Insights.Model"
             xmlns:preview="using:ScreenShare.App.Features.Insights.Preview.View"
             xmlns:verdict="using:ScreenShare.App.Features.Insights.Verdict.View"
             xmlns:viewers="using:ScreenShare.App.Features.Insights.ViewerTable.View"
             xmlns:vm="using:ScreenShare.App.Features.Insights.ViewModel"
             x:Class="ScreenShare.App.Features.Insights.View.InsightsView"
             x:DataType="vm:InsightsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.cardfigure">
      <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="StackPanel.figure">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
    </Style>
    <Style Selector="TextBlock.limit">
      <Setter Property="Grid.Row" Value="2" />
    </Style>
    <Style Selector="ItemsControl.wide StackPanel.figure">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.RowSpan" Value="2" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ItemsControl.wide TextBlock.limit">
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="TextBlock.cardfigure.past">
      <Setter Property="Foreground" Value="{StaticResource CautionBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource InsetPanel}" Spacing="{StaticResource GapPanel}">

      <StackPanel Spacing="2" IsVisible="{Binding HasTitle}">
        <TextBlock Classes="heading" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Title}" />
        <TextBlock Classes="hint" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Subtitle}" />
      </StackPanel>

      <!-- What the backend refused this screen, in its own words. Stop is pressed from the tray or the Go-strip. -->
      <Border Classes="panel" Padding="12,10" IsVisible="{Binding HasRefusal}">
        <SelectableTextBlock Classes="hint danger" TextWrapping="Wrap" Text="{Binding Refusal}" />
      </Border>

      <verdict:VerdictView DataContext="{Binding Verdict}" />

      <ListBox Theme="{StaticResource SegmentedControlTheme}"
               ItemContainerTheme="{StaticResource SegmentItemTheme}"
               Height="{StaticResource ControlHeight}"
               HorizontalAlignment="Left"
               ItemsSource="{Binding Tabs}"
               SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="model:InsightsTabRow">
            <TextBlock Text="{Binding Label}"
                       Foreground="{Binding $parent[ListBoxItem].Foreground}"
                       FontWeight="{Binding $parent[ListBoxItem].FontWeight}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Classes="fadesin" IsVisible="{Binding ShowsStream}" Spacing="{StaticResource GapControl}">
        <!-- Beside the cards on a wide window, the cards in a row under it on a narrow one. -->
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="{StaticResource GapControl}"
              RowSpacing="{StaticResource GapControl}">
          <Border Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="{Binding PreviewSpan}"
                  Width="{Binding PreviewWidth}">
            <preview:PreviewView DataContext="{Binding Preview}" />
          </Border>

          <ItemsControl Grid.Row="{Binding CardsRow}"
                        Grid.Column="{Binding CardsColumn}"
                        Grid.ColumnSpan="{Binding PreviewSpan}"
                        Classes.wide="{Binding IsWide}"
                        ItemsSource="{Binding Chart.Cards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid x:DataType="vm:InsightsViewModel"
                             Columns="{Binding CardColumns}"
                             ColumnSpacing="{StaticResource GapTight}"
                             RowSpacing="{StaticResource GapTight}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="chartvm:MetricCard">
                <Button Theme="{StaticResource OptionCard}"
                        Classes.picked="{Binding IsPicked}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Command="{Binding Pick}">
                  <!-- Beside the preview the figure stands right of its label; in a row under it, below. -->
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Row="0" Classes="cardtitle" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Label}" />
                    <StackPanel Classes="figure" Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="cardfigure" Classes.past="{Binding IsPast}" Text="{Binding Value}" />
                      <TextBlock Classes="hint" VerticalAlignment="Bottom" Margin="0,0,0,2" Text="{Binding Unit}" />
                    </StackPanel>
                    <TextBlock Classes="hint limit" Text="{Binding LimitCaption}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <chart:ChartView DataContext="{Binding Chart}" />
      </StackPanel>

      <StackPanel Classes="fadesin" IsVisible="{Binding ShowsViewers}" Spacing="{StaticResource GapControl}">
        <viewers:ViewerTableView DataContext="{Binding Viewers}" />
        <TextBlock Classes="hint" TextWrapping="Wrap" TextTrimming="None" Text="{Binding ViewersNote}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
