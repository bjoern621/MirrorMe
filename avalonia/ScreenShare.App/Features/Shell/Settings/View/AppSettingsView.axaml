<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:model="using:ScreenShare.App.Features.Shell.Settings.Model"
             xmlns:ti="using:TablerIcons"
             xmlns:view="using:ScreenShare.App.Features.Shell.Settings.View"
             xmlns:vm="using:ScreenShare.App.Features.Shell.Settings.ViewModel"
             x:Class="ScreenShare.App.Features.Shell.Settings.View.AppSettingsView"
             x:DataType="vm:AppSettingsViewModel"
             Focusable="True">

  <!--
    The settings about the app, over the window rather than in a destination of it
    (Features/Fields/Model/GroupPlacement.cs).

    A window of its own would leave what it is about undimmed and would need a caption drawn to match
    three desktops, so this is one control over the window's own grid.
    Nothing here commits: the group is applied, so a control is the write
    (docs/settings-editing.md, "Staged and applied").
  -->

  <UserControl.KeyBindings>
    <!--
      The dialog takes Escape before the window does, the event starting at the focus inside it
      and the code-behind putting the focus here as it opens.
    -->
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Resources>
    <DataTemplate x:Key="SettingsTabEntry" x:DataType="model:SettingsTab">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Label}"
                   Foreground="{Binding $parent[ListBoxItem].Foreground}"
                   FontWeight="{Binding $parent[ListBoxItem].FontWeight}" />
        <ti:TablerIcon Grid.Column="1"
                       Classes="button"
                       Icon="IconChevronRight"
                       Brush="{Binding $parent[ListBoxItem].Foreground, Mode=OneWay}"
                       IsVisible="{Binding $parent[view:AppSettingsView].((vm:AppSettingsViewModel)DataContext).IsCompact}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--
      Every size in setters, a local value outranking the compact style.
      Stretched up to a cap, so every section opens in one box and the window alone decides a smaller one.
    -->
    <Style Selector="Border.dialog">
      <Setter Property="MaxWidth" Value="680" />
      <Setter Property="MaxHeight" Value="480" />
      <Setter Property="Margin" Value="{StaticResource InsetSection}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.dialog.compact">
      <Setter Property="MaxWidth" Value="Infinity" />
      <Setter Property="MaxHeight" Value="Infinity" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.sectionlist">
      <Setter Property="Width" Value="170" />
      <Setter Property="Padding" Value="10,12" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.dialog.compact Border.sectionlist">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.dialog.compact ListBoxItem">
      <Setter Property="Padding" Value="10,12" />
    </Style>

    <!-- Development reads quieter than the sections a reader comes for, until it is picked. -->
    <Style Selector="ListBox.apart ListBoxItem:not(:selected)">
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Dimmed rather than covered: the window stays readable behind what is being decided over it. -->
  <Border Classes="scrim"
          IsVisible="{Binding IsOpen}"
          PointerPressed="ScrimPressed">

    <Border Classes="panel dialog"
            Classes.compact="{Binding IsCompact}"
            Padding="0"
            BoxShadow="{StaticResource MenuShadow}">

      <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,10,10,10">
          <Button Grid.Column="0"
                  Theme="{StaticResource IconButton}"
                  Margin="0,0,6,0"
                  IsVisible="{Binding ShowsBack}"
                  Command="{Binding BackCommand}"
                  ToolTip.Tip="{x:Static model:AppSettingsCopy.BackTip}">
            <ti:TablerIcon Classes="button" Icon="IconArrowLeft" />
          </Button>

          <TextBlock Grid.Column="1"
                     Classes="heading"
                     Margin="4,0,0,0"
                     VerticalAlignment="Center"
                     Text="{Binding Heading}" />

          <Button Grid.Column="2"
                  Theme="{StaticResource IconButton}"
                  Command="{Binding CloseCommand}"
                  ToolTip.Tip="{x:Static model:AppSettingsCopy.CloseTip}">
            <ti:TablerIcon Classes="button" Icon="IconX" />
          </Button>
        </Grid>
        <Border Grid.Row="0" Classes="dividerh" VerticalAlignment="Bottom" />

        <!--
          One section on screen, picked from the list beside it (Model/SettingsSection.cs).
          A window too narrow for both shows the list, then the section picked from it (Model/SettingsPlace.cs).
        -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

          <Border Grid.Column="0" Classes="sectionlist" IsVisible="{Binding ShowsList}">
            <StackPanel>
              <ListBox Theme="{StaticResource SectionListTheme}"
                       ItemContainerTheme="{StaticResource SectionItemTheme}"
                       ItemsSource="{Binding MainTabs}"
                       ItemTemplate="{DynamicResource SettingsTabEntry}"
                       SelectedItem="{Binding SelectedTab, Mode=TwoWay}" />
              <Border Classes="dividerh" Margin="0,8" />
              <!-- A second list for the entries under the divider, both writing the one section. -->
              <ListBox Classes="apart"
                       Theme="{StaticResource SectionListTheme}"
                       ItemContainerTheme="{StaticResource SectionItemTheme}"
                       ItemsSource="{Binding ApartTabs}"
                       ItemTemplate="{DynamicResource SettingsTabEntry}"
                       SelectedItem="{Binding SelectedTab, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Column="1"
                        Name="Sections"
                        IsVisible="{Binding ShowsSection}"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,14" Spacing="{StaticResource GapSection}">

              <StackPanel Spacing="6">
                <TextBlock Classes="cardtitle" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Question}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Lead}" />
              </StackPanel>

              <Panel>

                <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding Section, Converter={x:Static view:SectionShown.Instance}, ConverterParameter={x:Static model:SettingsSection.Window}}">
                  <!--
                    Pulled off the app group by key, so the write path stays the field's own (AppSettingsViewModel.Apply).
                    Margin cancels the row's own trailing 18px (FieldRow.axaml), built for an unspaced list,
                    so every pair in this dialog reads as the same gap.
                  -->
                  <ContentControl Content="{Binding TrayIcon}"
                                  ContentTemplate="{StaticResource FieldRow}"
                                  Margin="0,0,0,-18"
                                  IsVisible="{Binding TrayIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding Section, Converter={x:Static view:SectionShown.Instance}, ConverterParameter={x:Static model:SettingsSection.Logs}}">
                  <Button Theme="{StaticResource PrimaryButton}"
                          HorizontalAlignment="Left"
                          Content="{x:Static model:AppSettingsCopy.SendReport}"
                          Command="{Binding SendReport}"
                          controls:Pending.IsActive="{Binding SendReport.IsRunning}"
                          ToolTip.Tip="{x:Static model:AppSettingsCopy.SendReportTip}" />

                  <!--
                    Selectable and wrapping, as the update band's line is:
                    the stored name is what a reader carries into a bug report,
                    and a refusal is what they carry into a message about the send.
                  -->
                  <SelectableTextBlock Classes="hint"
                                       Classes.danger="{Binding ReportLineIsFailure}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       IsVisible="{Binding ReportLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Text="{Binding ReportLine}" />

                  <!-- Same cancelling margin as the row above. -->
                  <ContentControl Content="{Binding CrashReports}"
                                  ContentTemplate="{StaticResource FieldRow}"
                                  Margin="0,0,0,-18"
                                  IsVisible="{Binding CrashReports, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <Button Theme="{StaticResource LinkButton}"
                          HorizontalAlignment="Left"
                          Content="{x:Static model:AppSettingsCopy.OpenLogsFolder}"
                          Command="{Binding OpenLogsFolder}"
                          controls:Pending.IsActive="{Binding OpenLogsFolder.IsRunning}"
                          ToolTip.Tip="{x:Static model:AppSettingsCopy.OpenLogsFolderTip}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding Section, Converter={x:Static view:SectionShown.Instance}, ConverterParameter={x:Static model:SettingsSection.Updates}}">
                  <!--
                    One reason over the section, both controls under it being inert for that one fact.
                    The toggle's own row prints none (AppSettingsViewModel.UpdatesRefusal).
                  -->
                  <SelectableTextBlock Classes="reason"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       IsVisible="{Binding UpdatesRefused}"
                                       Text="{Binding UpdatesRefusal}" />

                  <!-- Same cancelling margin as the crash-report row. -->
                  <ContentControl Content="{Binding CheckUpdatesOnStart}"
                                  ContentTemplate="{StaticResource FieldRow}"
                                  Margin="0,0,0,-18"
                                  IsVisible="{Binding CheckUpdatesOnStart, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <!--
                    The band's own answer, the same view model behind both
                    (Features/Shell/Update/ViewModel/UpdateViewModel.cs).
                    Selectable and wrapping, a failing check being what a reader carries into a message.
                  -->
                  <SelectableTextBlock Classes="hint"
                                       Classes.danger="{Binding Updates.IsFailure}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       IsVisible="{Binding Updates.ShowsLine}"
                                       Text="{Binding Updates.Line}" />

                  <Button HorizontalAlignment="Left"
                          Content="{x:Static model:AppSettingsCopy.CheckNow}"
                          Command="{Binding Updates.Check}"
                          IsEnabled="{Binding Updates.CanCheck}"
                          controls:Pending.IsActive="{Binding Updates.Check.IsRunning}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding Section, Converter={x:Static view:SectionShown.Instance}, ConverterParameter={x:Static model:SettingsSection.Discord}}">
                  <!-- The account's picture stands where the sentence names the account. -->
                  <Border Classes="card" Padding="12,10">
                    <controls:AccountLine Classes="hint"
                                          Classes.danger="{Binding DiscordLineIsFailure}"
                                          TextWrapping="Wrap"
                                          TextTrimming="None"
                                          Sentence="{Binding DiscordLine}"
                                          Picture="{Binding DiscordAvatar}" />
                  </Border>

                  <!-- Beside the button rather than only on its hover, as the update check's reason is. -->
                  <SelectableTextBlock Classes="reason"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       IsVisible="{Binding LinkHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Text="{Binding LinkHint}" />

                  <!-- Same cancelling margin as the rows in the other sections. -->
                  <ContentControl Content="{Binding RichPresence}"
                                  ContentTemplate="{StaticResource FieldRow}"
                                  Margin="0,0,0,-18"
                                  IsVisible="{Binding RichPresence, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <!--
                    A link is one per computer and configures no stream, so it stands here rather than on the
                    wizard step where a stream picks its group (docs/discord-mode.md, "Linking, once per install").
                    The press opens the browser and takes as long as the person does, so the button waits on it.
                  -->
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Left"
                              Spacing="{StaticResource GapTight}">
                    <Button Content="{Binding LinkLabel}"
                            Command="{Binding LinkDiscord}"
                            controls:Pending.IsActive="{Binding LinkDiscord.IsRunning}"
                            ToolTip.Tip="{Binding LinkTip}" />

                    <!-- Beside a link alone: an install holding none has none to hand back. -->
                    <Button Theme="{StaticResource DangerButton}"
                            Content="{Binding UnlinkLabel}"
                            Command="{Binding UnlinkDiscord}"
                            controls:Pending.IsActive="{Binding UnlinkDiscord.IsRunning}"
                            IsVisible="{Binding IsDiscordLinked}"
                            ToolTip.Tip="{Binding UnlinkTip}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding Section, Converter={x:Static view:SectionShown.Instance}, ConverterParameter={x:Static model:SettingsSection.Development}}">
                  <!-- Same cancelling margin as the rows above. -->
                  <ContentControl Content="{Binding TestStreams}"
                                  ContentTemplate="{StaticResource FieldRow}"
                                  Margin="0,0,0,-18"
                                  IsVisible="{Binding TestStreams, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding Section, Converter={x:Static view:SectionShown.Instance}, ConverterParameter={x:Static model:SettingsSection.About}}">
                  <!-- Selectable: the build is what a bug report names. -->
                  <SelectableTextBlock Classes="figure" Text="{Binding Version}" />
                </StackPanel>

              </Panel>
            </StackPanel>
          </ScrollViewer>

        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
