<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:go="using:ScreenShare.App.Features.Shell.Go.View"
             xmlns:model="using:ScreenShare.App.Features.Shell.Settings.Model"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Shell.NavStrip.ViewModel"
             xmlns:shell="using:ScreenShare.App.Features.Shell.ViewModel"
             x:Class="ScreenShare.App.Features.Shell.NavStrip.View.NavStripView"
             x:DataType="vm:NavStripViewModel">

  <!-- Inset written out: GapPanel holds the same 12, and a Thickness has no token to name. -->
  <Border Classes="navstrip" Padding="12,0">
    <Grid ColumnDefinitions="Auto,*,Auto">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapControl}"
                  VerticalAlignment="Center">

        <!-- Height pinned to the control token: a segment sized by its text face measures per platform. -->
        <ListBox Theme="{StaticResource SegmentedControlTheme}"
                 ItemContainerTheme="{StaticResource SegmentItemTheme}"
                 Height="{StaticResource ControlHeight}"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}">

          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="shell:DestinationTab">
              <!--
                Read back off the container: a TextBlock foreground is stated app-wide,
                so inheritance loses to it and every segment state comes out one colour.
              -->
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapTight}">
                <ti:TablerIcon Classes="button"
                               Icon="{Binding Icon}"
                               Brush="{Binding $parent[ListBoxItem].Foreground, Mode=OneWay}"
                               VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}"
                           IsVisible="{Binding $parent[ListBox].((vm:NavStripViewModel)DataContext).ShowsLabels}"
                           Foreground="{Binding $parent[ListBoxItem].Foreground}"
                           FontWeight="{Binding $parent[ListBoxItem].FontWeight}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapControl}"
                  VerticalAlignment="Center">

        <!--
          The watch group, which acts on the viewer alone and which the publish wizard does not draw
          (Features/Fields/Model/GroupPlacement.cs).
        -->
        <Button Theme="{StaticResource IconButton}"
                IsVisible="{Binding ShowsWatch}"
                Command="{Binding Watch.Toggle, FallbackValue={x:Null}}"
                ToolTip.Tip="{Binding Watch.ToggleTip, FallbackValue={x:Null}}">
          <ti:TablerIcon Classes="button" Icon="IconAdjustmentsHorizontal" />
        </Button>

        <!--
          The settings about the app, which belong to no destination and so to no segment
          (Features/Shell/Settings/View/AppSettingsView.axaml).
          Drawn only where the shell gave the strip the command, as the commit beside it is.
        -->
        <Button Theme="{StaticResource IconButton}"
                Command="{Binding OpenSettings}"
                IsVisible="{Binding OpenSettings, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="{x:Static model:AppSettingsCopy.OpenTip}">
          <ti:TablerIcon Classes="button" Icon="IconSettings" />
        </Button>

        <!-- Drawn only where the shell gave the strip a commit; a test strip carries none. -->
        <go:GoView DataContext="{Binding Go}"
                   IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
