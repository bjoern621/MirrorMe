<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ScreenShare.App.Controls"
                    xmlns:model="using:ScreenShare.App.Features.Fields.Model"
                    xmlns:ti="using:TablerIcons"
                    xmlns:vm="using:ScreenShare.App.Features.Fields.ViewModel">

  <!--
    The info glyph beside a control's name, opening the comparison crops on hover.
    The pictures appear in the tip alone, so the cards stay one line of name and one of figure.
    A transparent box under the glyph takes the pointer between its strokes.
  -->
  <DataTemplate x:Key="ComparisonGlyph" x:DataType="vm:FieldViewModel">
    <Border Background="Transparent" Padding="4" VerticalAlignment="Center">
      <ToolTip.Tip>
        <ToolTip Classes="pictures">
          <ItemsControl ItemsSource="{Binding Comparison}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="{StaticResource GapControl}" LineSpacing="{StaticResource GapControl}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="model:Crop">
                <StackPanel Spacing="4">
                  <Image Stretch="None"
                         RenderOptions.BitmapInterpolationMode="None"
                         Source="{Binding Asset, Converter={x:Static controls:AssetBitmapConverter.Instance}}" />
                  <TextBlock Text="{Binding Caption}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ToolTip>
      </ToolTip.Tip>
      <ti:TablerIcon Icon="IconInfoCircle" Brush="{StaticResource MutedBrush}" />
    </Border>
  </DataTemplate>

</ResourceDictionary>
