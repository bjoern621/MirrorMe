<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="using:ScreenShare.App.Features.Setup.CostBar.View"
             xmlns:vm="using:ScreenShare.App.Features.Setup.CostBar.ViewModel"
             x:Class="ScreenShare.App.Features.Setup.CostBar.View.CostBarView"
             x:DataType="vm:CostBarViewModel">

  <UserControl.Styles>
    <!-- Ordinary fill hue set here and not on the element: an inline value is a LocalValue outranking every
         style setter, so the overrun below would never paint. -->
    <Style Selector="view|MeterBar">
      <Setter Property="FillBrush" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <!-- Amber over the limit: a setting asking for more than the line measured still publishes. -->
    <Style Selector="view|MeterBar.over">
      <Setter Property="FillBrush" Value="{StaticResource CautionBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- One row: the figure, the bar and the uplink it is measured against, the caption dropping where the row runs out. -->
  <Border Classes="card" Padding="12,9" IsVisible="{Binding IsResolved}">
    <DockPanel>
      <TextBlock DockPanel.Dock="Left"
                 Classes="label"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 FontFeatures="{StaticResource FigureFeatures}"
                 Text="{Binding Bitrate}" />
      <view:MeterBar DockPanel.Dock="Left"
                     Width="130"
                     Height="11"
                     Margin="12,0"
                     VerticalAlignment="Center"
                     Classes.over="{Binding IsOverUplink}"
                     Fill="{Binding FillShare}"
                     Limit="{Binding UplinkShare}"
                     TrackHeight="5"
                     TrackBrush="{StaticResource DividerBrush}"
                     LimitBrush="{StaticResource CautionBrush}" />
      <TextBlock Classes="hint"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 FontFeatures="{StaticResource FigureFeatures}"
                 Text="{Binding UplinkCaption}" />
    </DockPanel>
  </Border>

</UserControl>
