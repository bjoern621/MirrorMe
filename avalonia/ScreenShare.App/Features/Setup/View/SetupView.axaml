<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Setup.ViewModel"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:strip="using:ScreenShare.App.Features.Setup.StepStrip.View"
             xmlns:quality="using:ScreenShare.App.Features.Setup.QualityStep.View"
             xmlns:audio="using:ScreenShare.App.Features.Setup.AudioStep.View"
             xmlns:cost="using:ScreenShare.App.Features.Setup.CostBar.View"
             xmlns:checks="using:ScreenShare.App.Features.Setup.Checks.View"
             xmlns:presets="using:ScreenShare.App.Features.Setup.Presets.View"
             xmlns:commit="using:ScreenShare.App.Features.Setup.Commit.View"
             xmlns:relaycheck="using:ScreenShare.App.Features.Setup.RelayCheck.View"
             xmlns:fields="using:ScreenShare.App.Features.Fields.View"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.View.SetupView"
             x:DataType="vm:SetupViewModel"
             Background="{StaticResource SurfaceBrush}">

  <UserControl.Styles>
    <Style Selector=":is(UserControl).narrow TextBlock.backword">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <strip:StepStripView DockPanel.Dock="Top" Margin="12,12,12,0" />

    <!--
      What the backend said when it could not describe the screen,
      so no step can be drawn from anything newer.
      No form is invented in its place (docs/ipc-api.md, "What each side owes").
    -->
    <controls:Reveal IsOpen="{Binding IsUnavailable}" FollowsOpening="False" LeavesNoGap="True" DockPanel.Dock="Top">
      <Border
              Classes="panel"
              Padding="12,10"
              Margin="12,12,12,0">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <SelectableTextBlock Grid.Column="0"
                               Classes="hint danger"
                               VerticalAlignment="Center"
                               Text="{Binding Unavailable}" />
  
          <!--
            The same turning arc a pressed control wears: connecting speaks one vocabulary across this app
            (docs/design-language.md, "Status language").
            Carries a tip, the sentence beside it saying what failed rather than that anything is still coming.
          -->
          <controls:Waiting Grid.Column="1"
                            Margin="12,0,0,0"
                            IsVisible="{Binding IsDialling}"
                            ToolTip.Tip="{x:Static copy:Cards.Redialling}" />
  
          <Button Grid.Column="2"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Content="Look again"
                  Command="{Binding RetryCommand}"
                  controls:Pending.IsActive="{Binding RetryCommand.IsRunning}" />
        </Grid>
      </Border>
    </controls:Reveal>

    <!--
      What the backend said when a setting could not be stored, separate news from the banner above:
      a read that failed leaves an older answer on screen,
      a write that failed leaves what was typed on screen while the backend runs on the value before it.
      Nothing to look again at, so no button (Backend/FormSession.cs).
    -->
    <controls:Reveal IsOpen="{Binding HasUnsaved}" FollowsOpening="False" LeavesNoGap="True" DockPanel.Dock="Top">
      <Border
              Classes="panel"
              Padding="12,10"
              Margin="12,12,12,0">
        <SelectableTextBlock Classes="hint danger" Text="{Binding Unsaved}" />
      </Border>
    </controls:Reveal>

    <!--
      The step column's foot, floating over it on every step: moving between steps,
      and on the last one the commit in Continue's place.
      One bar for both, so the button that ends the flow stands where the button that walks it does.
      Docked, so the column scrolls to its last card above the bar and nothing hides behind it.
    -->
    <Panel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Width="{Binding #Column.Viewport.Width}">
      <Border Classes="floatbar"
              Margin="12,0,12,12"
              Padding="{StaticResource InsetPanel}"
              MaxWidth="{StaticResource StepColumnWidth}">
        <Panel>
          <Grid Classes="fadesin" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !ShowsCommit}">
            <Button Grid.Column="0"
                    Theme="{StaticResource LinkButton}"
                    Height="{StaticResource FooterButtonHeight}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapTight}">
                <ti:TablerIcon Classes="button" Icon="IconArrowLeft" Brush="{Binding $parent[Button].Foreground, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Classes="backword" Text="Back" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Theme="{StaticResource PrimaryButton}"
                    Height="{StaticResource FooterButtonHeight}"
                    Padding="20,0"
                    Command="{Binding ContinueCommand}"
                    IsVisible="{Binding CanContinue}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapTight}">
                <TextBlock Text="{Binding ContinueLabel}" VerticalAlignment="Center" />
                <ti:TablerIcon Classes="button" Icon="IconArrowRight" Brush="{Binding $parent[Button].Foreground, Mode=OneWay}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <Panel Classes="fadesin" IsVisible="{Binding ShowsCommit}">
            <commit:CommitCardView DataContext="{Binding Commit}" />
          </Panel>
        </Panel>
      </Border>
    </Panel>

    <!--
      What the draft costs, above the column on every step, so the figure stays in view while a choice moves it.
      The bar and the foot take the column's viewport width, so a scroll bar's lane shifts all three alike.
    -->
    <Panel DockPanel.Dock="Top" HorizontalAlignment="Left" Width="{Binding #Column.Viewport.Width}">
      <cost:CostBarView Margin="12,12,12,0" MaxWidth="{StaticResource StepColumnWidth}" DataContext="{Binding Cost}" />
    </Panel>

    <!--
      One column, centred and capped on a wide window.
      Every step's form stacks in it, and the gap falls between the children that drew something
      (Controls/CardColumn).
    -->
    <ScrollViewer x:Name="Column" HorizontalScrollBarVisibility="Disabled">
      <controls:CardColumn Spacing="{StaticResource GapPanel}"
                           Margin="{StaticResource InsetPanel}"
                           MaxWidth="{StaticResource StepColumnWidth}">

        <!--
          What stands where the steps will, for as long as the form deciding them is out.
          Every branch below draws from that form, so all of them are empty here and the column
          would otherwise be a blank screen on launch.
          The arc sits under the sentence, which already says what is being read.
        -->
        <StackPanel Spacing="{StaticResource GapTight}"
                    Margin="2,0"
                    IsVisible="{Binding IsReading}">
          <TextBlock Classes="hint" Text="{x:Static copy:Cards.SetupUnread}" TextWrapping="Wrap" />
          <controls:Waiting />
        </StackPanel>

        <controls:CardColumn Classes="fadesin" Spacing="{StaticResource GapPanel}" IsVisible="{Binding ShowsQuality}">
          <!-- A preset sets every field below it at once, so its card leads the step. -->
          <presets:PresetsView DataContext="{Binding Presets}" />
          <quality:QualityStepView DataContext="{Binding Quality}" />
        </controls:CardColumn>

        <!--
          The audio group's own layout: one row per source,
          rather than the four controls of every entry drawn with their copy repeated (Setup/AudioStep).
          The wrapper is load-bearing: IsVisible reads this view's model,
          so it cannot sit on the element that hands its DataContext to the child.
        -->
        <Panel Classes="fadesin" IsVisible="{Binding ShowsAudio}">
          <audio:AudioStepView DataContext="{Binding Audio}" />
        </Panel>

        <!--
          One renderer instanced per group, and the group decides everything on it.
          A hand-written capture screen beside a hand-written encode screen would write down, in this shell,
          what a capture and an encode are (docs/ipc-api.md).
        -->
        <controls:CardColumn Classes="fadesin" Spacing="{StaticResource GapPanel}" IsVisible="{Binding ShowsFields}">

          <!--
            No group, no card:
            a form that never arrived leaves the step column empty rather than drawing a frame around nothing.
            The wrapper is load-bearing, as on the audio group above.
          -->
          <Panel IsVisible="{Binding CurrentGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
            <fields:FieldGroupView DataContext="{Binding CurrentGroup}" />
          </Panel>

          <!--
            What answers on the relay, placed unconditionally and visible on its own terms:
            it draws on the step holding the relay's address and ports,
            which is where a leg nothing reaches is corrected (Setup/RelayCheck).
            Below the group, the check being about the values on the card.
          -->
          <relaycheck:RelayCheckView DataContext="{Binding RelayCheck}" />

          <!-- The group this step hosts, under its own: how the stream reaches the relay, on the step asking who can watch. -->
          <Panel IsVisible="{Binding HostedGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
            <fields:FieldGroupView DataContext="{Binding HostedGroup}" />
          </Panel>
        </controls:CardColumn>

        <!-- Last in the column: what no control above already says. -->
        <checks:ChecksCardView DataContext="{Binding Checks}" />
      </controls:CardColumn>
    </ScrollViewer>
  </DockPanel>

</UserControl>
