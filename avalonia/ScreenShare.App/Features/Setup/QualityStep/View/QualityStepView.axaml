<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:fields="using:ScreenShare.App.Features.Fields.Model"
             xmlns:vm="using:ScreenShare.App.Features.Setup.QualityStep.ViewModel"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.QualityStep.View.QualityStepView"
             x:DataType="vm:QualityStepViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Features/Setup/QualityStep/View/ChoiceCard.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- An open expert row already names its control in the row heading it, so the field row drops its own label. -->
    <Style Selector="ContentControl.expert TextBlock.fieldlabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <!--
    Nothing before the first resolve, and nothing for a backend that does not describe this step:
    the unreachable backend already says so once above the column.
  -->
  <StackPanel Spacing="{StaticResource GapPanel}" IsVisible="{Binding IsResolved}">

    <ItemsControl ItemsSource="{Binding Questions}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="{StaticResource GapSection}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:QuestionRow">
          <Border Classes="question">
            <StackPanel Spacing="{StaticResource GapControl}">

              <!-- A number with a ladder takes a typed value as well, beside the question asking it. -->
              <!-- The glyph rides inline after the question, so a heading that wraps carries it on its last line. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="heading" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None">
                  <Run Text="{Binding Heading}" />
                  <InlineUIContainer BaselineAlignment="TextBottom">
                    <ContentControl IsVisible="{Binding Field.HasComparison}"
                                    Content="{Binding Field}"
                                    ContentTemplate="{StaticResource ComparisonGlyph}" />
                  </InlineUIContainer>
                </TextBlock>
                <NumericUpDown Grid.Column="1"
                               IsVisible="{Binding Field.IsNumberBox}"
                               IsEnabled="{Binding Field.IsEnabled}"
                               Value="{Binding Field.Number, Mode=TwoWay}"
                               Minimum="{Binding Field.NumberMinimum}"
                               Maximum="{Binding Field.NumberMaximum}"
                               Increment="{Binding Field.NumberStep}"
                               FormatString="0"
                               MinWidth="110"
                               ToolTip.Tip="{Binding Field.Label}" />
              </Grid>

              <SelectableTextBlock Classes="reason" IsVisible="{Binding Field.HasReason}" Text="{Binding Field.Reason}" />

              <ItemsControl ItemsSource="{Binding Field.Offered}"
                            ItemTemplate="{StaticResource ChoiceCard}"
                            IsEnabled="{Binding Field.IsEnabled}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:ChoiceRowPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- The refused entries under their own disclosure, so revealing them moves no card above it. -->
              <Button Theme="{StaticResource LinkButton}"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding Field.HasRefused}"
                      Command="{Binding Field.RevealCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ti:TablerIcon Icon="{Binding Field.RefusedGlyph}" Brush="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="secondary" Text="{Binding Field.RefusedTitle}" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="{Binding Field.RefusedCount}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <ItemsControl ItemsSource="{Binding Field.Refused}"
                            ItemTemplate="{StaticResource ChoiceCard}"
                            IsVisible="{Binding Field.RefusedShown}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:ChoiceRowPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- What the picked entry is for, and what the form says at this control, once under the question. -->
              <TextBlock Classes="secondary"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         IsVisible="{Binding Field.Picked.HasDetail, FallbackValue=False}"
                         Text="{Binding Field.Picked.Detail, FallbackValue=''}" />

              <ItemsControl ItemsSource="{Binding Field.Diagnostics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="fields:Impact">
                    <controls:CheckItem Margin="0,0,0,7" Text="{Binding Text}" State="{Binding State}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl IsVisible="{Binding Field.HasNotes}"
                            ItemsSource="{Binding Field.Notes}"
                            ItemsPanel="{StaticResource ChipPanel}"
                            ItemTemplate="{StaticResource ImpactChip}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Every encode control the questions leave, one closed row each, behind one disclosure. -->
    <Border Classes="question" IsVisible="{Binding Expert.Fold.HasAny}">
      <StackPanel>
        <ContentControl Content="{Binding Expert.Fold}" ContentTemplate="{StaticResource FoldDisclosure}" />

        <ItemsControl ItemsSource="{Binding Expert.Rows}" IsVisible="{Binding Expert.Fold.Shown}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ExpertRow">
              <StackPanel>
                <!-- A greyed row keeps its value and its reason, and opens onto nothing. -->
                <Button Theme="{StaticResource RowButton}" Command="{Binding Toggle}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6">
                    <TextBlock Grid.Column="0" Classes="secondary" VerticalAlignment="Center" Text="{Binding Field.Label}" />
                    <ContentControl Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding Field.HasComparison}"
                                    Content="{Binding Field}"
                                    ContentTemplate="{StaticResource ComparisonGlyph}" />
                    <!-- The open control shows the value itself. -->
                    <TextBlock Grid.Column="2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsOpen}"
                               FontFeatures="{StaticResource FigureFeatures}"
                               Text="{Binding Field.PickedLabel}" />
                    <ti:TablerIcon Grid.Column="3"
                                   Margin="8,0,0,0"
                                   Icon="IconChevronDown"
                                   Brush="{StaticResource MutedBrush}"
                                   IsVisible="{Binding Field.IsEnabled}"
                                   VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <SelectableTextBlock Classes="reason"
                                     Margin="7,0,0,6"
                                     IsVisible="{Binding !Field.IsEnabled}"
                                     Text="{Binding Field.Reason}" />
                <!-- The open control draws its own lines under it. -->
                <ItemsControl Margin="7,0,0,0" IsVisible="{Binding !IsOpen}" ItemsSource="{Binding Field.Diagnostics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="fields:Impact">
                      <controls:CheckItem Margin="0,0,0,7" Text="{Binding Text}" State="{Binding State}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Classes="expert"
                                Margin="7,4,0,0"
                                IsVisible="{Binding IsOpen}"
                                Content="{Binding Field}"
                                ContentTemplate="{StaticResource FieldRow}" />
                <Grid ColumnDefinitions="*,Auto" Margin="7,8,0,8" IsVisible="{Binding IsOpen}">
                  <ItemsControl Grid.Column="0" VerticalAlignment="Center" ItemsSource="{Binding Pips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:Boolean">
                        <Border Classes="pip" Classes.current="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Grid.Column="1"
                          Theme="{StaticResource LinkButton}"
                          IsVisible="{Binding HasNext}"
                          Command="{Binding Next}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding NextLabel}" />
                      <ti:TablerIcon Icon="IconArrowRight" Brush="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>

</UserControl>
