<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The switch a flag wears here: never a CheckBox.
    Built on ToggleButton and not ToggleSwitch, whose knob animation demands a set of named template
    parts that this theme would then have to hide.
  -->
  <ControlTheme x:Key="SwitchTheme" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Track"
                Width="34" Height="18"
                CornerRadius="9"
                Background="{StaticResource ControlBrush}"
                BorderThickness="1"
                BorderBrush="{StaticResource ChipBorderBrush}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{StaticResource MotionMove}" Easing="{StaticResource MotionEase}" />
              <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionHover}" Easing="{StaticResource MotionEase}" />
            </Transitions>
          </Border.Transitions>
          <!--
            Even against the track's 16px inner box, so the inset around the knob is a whole 2px.
            Pinned left and moved by a translation, which slides where a change of alignment would jump.
          -->
          <Ellipse Name="Knob"
                   Width="12" Height="12"
                   Margin="3,0"
                   Fill="{StaticResource MutedBrush}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   RenderTransform="none">
            <Ellipse.Transitions>
              <Transitions>
                <BrushTransition Property="Fill" Duration="{StaticResource MotionMove}" Easing="{StaticResource MotionEase}" />
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionMove}" Easing="{StaticResource MotionEase}" />
              </Transitions>
            </Ellipse.Transitions>
          </Ellipse>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
    </Style>
    <!-- The 32px inner box, less the knob and its two 3px margins. -->
    <Style Selector="^:checked /template/ Ellipse#Knob">
      <Setter Property="Fill" Value="{StaticResource OnSelectedBrush}" />
      <Setter Property="RenderTransform" Value="translateX(14px)" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#Track">
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#Knob">
      <Setter Property="Fill" Value="{StaticResource DisabledBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
