<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ScreenShare.App.Controls"
        xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View">

  <!--
    Every fill and every edge in the app.
    Nothing outside this file states one.
  -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
  </Style>

  <!--
    A card rises into place each time it is shown: as its step opens, and as the form brings it back.
    Matched on IsVisible, so the animation replays on every showing and not on the first one alone.
  -->
  <Style Selector="Border.card[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="{StaticResource MotionMount}" Easing="{StaticResource MotionEase}">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="RenderTransform" Value="translateY(6px)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="none" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A picture fades in over its ground once frames arrive, and out while the tile is dark. -->
  <Style Selector="tiles|StreamTile">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{StaticResource MotionPicture}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="tiles|StreamTile.dark">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!--
    A step, tab, section or whole screen fades in each time it is shown.
    Matched on its own IsVisible, as a card is: a card inside keeps its own flag and rises on its first showing alone.
  -->
  <Style Selector=":is(Control).fadesin[IsVisible=True], ContentControl.screens > :is(Control)">
    <Style.Animations>
      <Animation Duration="{StaticResource MotionMount}" Easing="{StaticResource MotionEase}">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    The dimmed ground a dialog stands on, over the whole window.
    The Overlay around it fades it in and out (Controls/Overlay/Overlay.cs), and the dialog's panel grows into place on it.
    A sheet mounted for one showing has no Overlay and fades in on its own.
  -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
  </Style>
  <Style Selector="Border.scrim.mounting[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="{StaticResource MotionOpen}" Easing="{StaticResource MotionEase}">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- A sheet on a narrow window rises from the foot it is pinned to. -->
  <Style Selector="Border.risingsheet[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="{StaticResource MotionMount}" Easing="{StaticResource MotionEase}">
        <KeyFrame Cue="0%">
          <Setter Property="RenderTransform" Value="translateY(48px)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RenderTransform" Value="none" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.scrim[IsVisible=True] > Border.panel">
    <Style.Animations>
      <Animation Duration="{StaticResource MotionMount}" Easing="{StaticResource MotionEase}">
        <KeyFrame Cue="0%">
          <Setter Property="RenderTransform" Value="scale(0.96)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RenderTransform" Value="none" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    A question on the step column: on the surface itself, no fill and no edge,
    so the picked choice is the brightest thing on screen.
  -->
  <Style Selector="Border.question">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- A word pinned to a card, such as Recommended: a capsule that inverts with the card it sits on. -->
  <!-- The marks that follow a pick ease into their new fill and edge. -->
  <Style Selector="Border.tag, Border.crop, Border.impact">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <controls:BrushFade Property="Background" Duration="{StaticResource MotionHover}" Easing="{StaticResource MotionEase}" />
        <controls:BrushFade Property="BorderBrush" Duration="{StaticResource MotionHover}" Easing="{StaticResource MotionEase}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionMove}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.tag">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}" />
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="Button.picked Border.tag">
    <Setter Property="Background" Value="{DynamicResource OnSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OnSelectedBrush}" />
  </Style>

  <!-- One comparison picture, outlined in white where it shows the entry the field holds. -->
  <Style Selector="Border.crop">
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.crop.picked">
    <Setter Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- What a choice raises, a glyph and a few words under its sentence. Inverts with the card it sits on. -->
  <Style Selector="Border.impact">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}" />
    <Setter Property="Padding" Value="6,2,8,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.picked Border.impact">
    <Setter Property="Background">
      <SolidColorBrush Color="{DynamicResource Grey100}" />
    </Setter>
    <Setter Property="BorderBrush">
      <SolidColorBrush Color="{DynamicResource Grey150}" />
    </Setter>
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
  </Style>

  <Style Selector="Border.chromeband">
    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
  </Style>

  <!--
    A side column drawn over the body rather than beside it, on a window with the width for one column
    (docs/design-language.md, "Narrow windows").
    The app's own fill, so what it covers stops showing through it.
  -->
  <Style Selector="Border.overbody">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!--
    The wizard's action bar, floating over the foot of the step column on every step.
    The one shadow a floating surface casts, so it reads above the cards scrolling under it.
  -->
  <Style Selector="Border.floatbar">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource MenuShadow}" />
  </Style>

  <Style Selector="Border.navstrip">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <!--
      A minimum rather than a fixed height.
      The strip's hint wraps on a window too narrow to hold it, and a fixed height would cut the second line off.
    -->
    <Setter Property="MinHeight" Value="{DynamicResource NavStripHeight}" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusTile}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Between two regions of one strip, so the 18px is the strip's height and not the window's. -->
  <Style Selector="Border.dividerv">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
  </Style>

  <Style Selector="Border.dividerh">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="Border.rowrule">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

</Styles>
