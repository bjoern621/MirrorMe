<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!--
    Sizes the design states, named by what they measure.
    A height here is the Avalonia one and includes its borders,
    where the mockup's CSS content-box number excludes them.
  -->

  <!-- Radius is keyed on what a thing is, never on how big it is. -->
  <CornerRadius x:Key="RadiusSegment">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">5</CornerRadius>
  <CornerRadius x:Key="RadiusButton">6</CornerRadius>
  <CornerRadius x:Key="RadiusStrip">7</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
  <CornerRadius x:Key="RadiusTile">9</CornerRadius>
  <!-- RadiusTile again, for a Shape whose corner takes a Double. The two state one radius. -->
  <sys:Double x:Key="RadiusTileValue">9</sys:Double>
  <!-- The one capsule: a stream chip. -->
  <CornerRadius x:Key="RadiusChip">14</CornerRadius>
  <!-- Half the portrait, which is what makes it a circle. -->
  <CornerRadius x:Key="RadiusAvatar">10</CornerRadius>
  <CornerRadius x:Key="RadiusAvatarInline">8</CornerRadius>

  <!--
    Two widgets glued at a shared edge, carrying the control radius with the inner corners taken off.
    Stated here rather than at the joint, so a radius that moves cannot move on one side only.
  -->
  <CornerRadius x:Key="RadiusControlLeading">5,0,0,5</CornerRadius>
  <CornerRadius x:Key="RadiusControlTrailing">0,5,5,0</CornerRadius>
  <CornerRadius x:Key="RadiusButtonLeading">6,0,0,6</CornerRadius>
  <CornerRadius x:Key="RadiusButtonTrailing">0,6,6,0</CornerRadius>

  <!--
    Chrome bands, full bleed, so these heights are the window's fixed rows.
    A band is sized from the text it holds, so the ladder in Design/Typography.axaml moves them.
  -->
  <sys:Double x:Key="TitleBarHeight">36</sys:Double>
  <!--
    Windows' own caption measurements rather than a step off the icon ladder below.
    A caption button is read against the other windows on the screen (docs/design-language.md).
  -->
  <sys:Double x:Key="CaptionGlyphSize">10</sys:Double>
  <sys:Double x:Key="CaptionStroke">1</sys:Double>
  <!-- The 30px control it holds, 6px of air either side, plus the 1px bottom rule. -->
  <sys:Double x:Key="NavStripHeight">43</sys:Double>
  <sys:Double x:Key="StatusBarHeight">30</sys:Double>

  <!-- The 20px line box a 14px label draws, plus 4px either side and two borders. -->
  <sys:Double x:Key="ControlHeight">30</sys:Double>
  <!-- The same box without a border. -->
  <sys:Double x:Key="PillHeight">28</sys:Double>
  <sys:Double x:Key="ChipHeight">30</sys:Double>
  <!-- Pinned rather than sized to its text, so a column of rows keeps one rhythm whatever a row holds. -->
  <sys:Double x:Key="TextRowHeight">26</sys:Double>
  <!-- Inside the text row, so a picture beside a name adds no height to the row it sits in. -->
  <sys:Double x:Key="AvatarSize">20</sys:Double>
  <!-- Inside a sentence, where the line box is the text's own. -->
  <sys:Double x:Key="AvatarSizeInline">16</sys:Double>
  <!-- The word space after a picture, the one in front of it being the sentence's own. -->
  <Thickness x:Key="AvatarInlineGap">0,0,4,0</Thickness>
  <sys:Double x:Key="MenuItemHeight">32</sys:Double>
  <sys:Double x:Key="ActionHeight">32</sys:Double>
  <sys:Double x:Key="FooterButtonHeight">38</sys:Double>
  <sys:Double x:Key="RoundButtonSize">40</sys:Double>
  <!-- The control height less the two borders a glyph-only button does not carry. -->
  <sys:Double x:Key="IconButtonSize">28</sys:Double>
  <!-- The same button inside a control rather than beside one: the box's borders, and 3px of air either side. -->
  <sys:Double x:Key="InlineButtonSize">22</sys:Double>
  <!-- The air around that button: the text runs up to it, and it clears the box's own edge. -->
  <Thickness x:Key="InnerContentGap">6,0,4,0</Thickness>
  <!-- Taller than a control: the row is the target, not a control at the end of it. -->
  <sys:Double x:Key="RowButtonHeight">36</sys:Double>
  <!-- The stage's side edge a pointer steps from, the full height of the stage. -->
  <sys:Double x:Key="StageEdgeWidth">96</sys:Double>
  <!--
    The ellipse an edge clips its arc of shade from: twice the edge's width, centred on the outer side,
    and reaching past the picture's top and bottom so those ends curve as well.
  -->
  <sys:Double x:Key="StageArcWidth">192</sys:Double>
  <Thickness x:Key="StageArcLeftMargin">-96,-56,0,-56</Thickness>
  <Thickness x:Key="StageArcRightMargin">0,-56,-96,-56</Thickness>
  <!-- The round disc under an edge's glyph, the radius half its size. -->
  <sys:Double x:Key="StageDiscSize">44</sys:Double>
  <CornerRadius x:Key="RadiusStageDisc">22</CornerRadius>

  <!-- Setup's one column on a wide window: a choice row three cards across, and no line too long to read. -->
  <sys:Double x:Key="StepColumnWidth">640</sys:Double>

  <!-- A small set used repeatedly, not a scale. -->
  <sys:Double x:Key="GapTight">7</sys:Double>
  <sys:Double x:Key="GapControl">10</sys:Double>
  <sys:Double x:Key="GapPanel">12</sys:Double>
  <sys:Double x:Key="GapSection">16</sys:Double>

  <!--
    The same four steps as a Thickness, since a StaticResource converts between neither type.
    A Margin handed the Double above compiles and throws InvalidCastException in the first layout pass.
    Uniform only: a box needing one edge different writes its four numbers where it needs them.
  -->
  <Thickness x:Key="InsetTight">7</Thickness>
  <Thickness x:Key="InsetControl">10</Thickness>
  <Thickness x:Key="InsetPanel">12</Thickness>
  <Thickness x:Key="InsetSection">16</Thickness>

  <!--
    One step below the ladder above, and the menu surface's padding rather than a row's margin.
    A row is a filled rounded box that has to clear the surface's 1px border,
    and a margin would leave its hit area outside its fill.
  -->
  <Thickness x:Key="InsetMenu">5</Thickness>

  <!--
    The scroll bar's lane: the bar itself, and the air between it and the content it sits beside
    (Design/Scrolling.axaml).
    ScrollBarSize is Fluent's key, read by its bar template for the track, the thumb and the buttons.
    10 against the 16 Fluent ships: a bar marks where the view sits, and the wheel does the scrolling.
  -->
  <sys:Double x:Key="ScrollBarSize">10</sys:Double>
  <Thickness x:Key="ScrollBarGapVertical">4,0,0,0</Thickness>
  <Thickness x:Key="ScrollBarGapHorizontal">0,4,0,0</Thickness>

  <!--
    Small, because it is state and not decoration (docs/design-language.md).
    Even, so a dot centred in a 30px control keeps to whole pixels.
  -->
  <sys:Double x:Key="DotSize">8</sys:Double>

  <!--
    One size for every control that can be waiting.
    A spinner scaled per button would make one state read as several.
    It is the control-glyph size, so a working button carries the weight of one that is not.
  -->
  <sys:Double x:Key="SpinnerSize">14</sys:Double>
  <sys:Double x:Key="SpinnerStroke">1.5</sys:Double>

  <!--
    Three sizes off the design's 12-22px range, named by where a glyph sits, and one stroke under all of them.
    The window controls are not on this ladder.

    A stroke is in the glyph's own 24-unit artwork rather than in pixels,
    so what lands on the screen is the number times the size the glyph is drawn at, over 24:
    2.5 is about 1.25px on a 12px badge glyph and 1.7px on a 16px button glyph.
    Above 3 the 12px glyphs clog, the gear's teeth and the info circle's ring closing into a blob.
  -->
  <sys:Single x:Key="IconStroke">2.5</sys:Single>
  <!-- Inside a badge or a pill, where the surrounding shape is already 15-16px. -->
  <sys:Double x:Key="IconSizeBadge">12</sys:Double>
  <sys:Double x:Key="IconSizeControl">14</sys:Double>
  <!--
    Alone in a button, where the glyph is the whole of what the control says.
    14px inside a 28px box reads as a box with something small in the middle.
  -->
  <sys:Double x:Key="IconSizeButton">16</sys:Double>

  <!--
    A thumbnail in the film strip under a spotlit stream, and a height alone.
    The width follows from the shape the grid cuts its cells to,
    and a short window shrinks the band rather than taking the spotlight's room.
  -->
  <sys:Double x:Key="StripTileHeight">112</sys:Double>

  <!-- The zoom map over a zoomed picture, a width alone: the height follows the picture's shape. -->
  <sys:Double x:Key="ZoomMapWidth">96</sys:Double>

  <!--
    Motion (docs/design-language.md, "Motion").
    One duration per kind of change, so a hover reads alike on every control.
    Every transition eases out: the change lands fast and settles.
  -->
  <sys:TimeSpan x:Key="MotionHover">0:0:0.16</sys:TimeSpan>
  <!-- Short, so a quick click still shows the button going in and coming back. -->
  <sys:TimeSpan x:Key="MotionPress">0:0:0.09</sys:TimeSpan>
  <!-- A knob or a chevron moving between two places. -->
  <sys:TimeSpan x:Key="MotionMove">0:0:0.18</sys:TimeSpan>
  <!-- A floating surface coming in, and going out a little faster than it came. -->
  <sys:TimeSpan x:Key="MotionOpen">0:0:0.16</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionClose">0:0:0.11</sys:TimeSpan>
  <!-- A glyph or a mark appearing on a state change. -->
  <sys:TimeSpan x:Key="MotionMark">0:0:0.2</sys:TimeSpan>
  <!-- A fold's body unrolling to its height, and rolling back up. -->
  <sys:TimeSpan x:Key="MotionFold">0:0:0.22</sys:TimeSpan>
  <!-- A tile taking its place, and a picture fading in over it once frames arrive. -->
  <sys:TimeSpan x:Key="MotionMount">0:0:0.26</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionPicture">0:0:0.5</sys:TimeSpan>
  <CubicEaseOut x:Key="MotionEase" />

</ResourceDictionary>
