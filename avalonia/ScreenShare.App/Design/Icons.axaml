<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ti="using:TablerIcons">

  <!--
    One rule for the icon set rather than a decision per glyph.
    Every icon is a Tabler outline glyph from the TablerIcons.Avalonia package, and no surface draws its own
    (docs/design-language.md).
    Emoji and box-drawing characters are no alternative: the emoji font paints in colour and ignores the brush,
    and a font's box metrics move with the face.
    TablerIcon is a Control rather than a TemplatedControl, so it has no Foreground to inherit
    and its Brush defaults to black.
    The default below keeps that black off the screen, and a view wanting another role states it.
  -->
  <Style Selector="ti|TablerIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeControl}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeControl}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource IconStroke}" />
    <Setter Property="Brush" Value="{DynamicResource GlyphBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Brush" Duration="{StaticResource MotionHover}" Easing="{StaticResource MotionEase}" />
        <DoubleTransition Property="Opacity" Duration="{StaticResource MotionHover}" Easing="{StaticResource MotionEase}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionMove}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </Style>

  <!--
    A glyph lifts under the pointer of the button carrying it, and sinks back under the press.
    A greyed control holds its glyph still, having no press to promise.
    A menu row lifts its own glyph (Design/Menus.axaml).
  -->
  <Style Selector="Button:pointerover:not(:disabled) ti|TablerIcon">
    <Setter Property="RenderTransform" Value="scale(1.12)" />
  </Style>
  <Style Selector="Button:pressed:not(:disabled) ti|TablerIcon">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>
  <Style Selector="ToggleButton:pointerover:not(:disabled) ti|TablerIcon">
    <Setter Property="RenderTransform" Value="scale(1.12)" />
  </Style>

  <Style Selector="ti|TablerIcon.badge">
    <Setter Property="Width" Value="{DynamicResource IconSizeBadge}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeBadge}" />
  </Style>

  <Style Selector="ti|TablerIcon.button">
    <Setter Property="Width" Value="{DynamicResource IconSizeButton}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeButton}" />
  </Style>

  <!-- Mark of what a choice or a fold raises: grey for a note, amber for a warning, red for what stops the stream. -->
  <Style Selector="ti|TablerIcon.impact">
    <Setter Property="Brush" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="ti|TablerIcon.impact.warns">
    <Setter Property="Brush" Value="{DynamicResource CautionBrush}" />
  </Style>
  <Style Selector="ti|TablerIcon.impact.blocks">
    <Setter Property="Brush" Value="{DynamicResource AttentionBrush}" />
  </Style>
  <Style Selector="Button.picked ti|TablerIcon.impact">
    <Setter Property="Brush" Value="{DynamicResource OnSelectedMutedBrush}" />
  </Style>

  <!-- Radio mark of a choice card: a ring, filled to a thick ring on the picked card. -->
  <Style Selector="Ellipse.radiodot">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stroke" Value="{DynamicResource HintBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="{StaticResource MotionHover}" Easing="{StaticResource MotionEase}" />
        <DoubleTransition Property="StrokeThickness" Duration="{StaticResource MotionMove}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.picked Ellipse.radiodot">
    <Setter Property="Stroke" Value="{DynamicResource OnSelectedBrush}" />
    <Setter Property="StrokeThickness" Value="4" />
  </Style>

  <!--
    Paths and not text: Windows draws these from Segoe Fluent Icons' private use area,
    so a missing face paints a tofu box where the close button was.
    Drawn rather than taken from the icon set, at the platform's numbers, because a caption button
    is read against the other windows on the screen and not against the app underneath it.
    Stretch is None, so the geometry in TitleBarView maps one unit to one pixel,
    and its half-pixel coordinates put a 1px line on a whole pixel row.
    The brush is a default the buttons override, so a glyph follows their states.
  -->
  <Style Selector="Path.caption">
    <Setter Property="Width" Value="{DynamicResource CaptionGlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource CaptionGlyphSize}" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="{DynamicResource CaptionStroke}" />
    <Setter Property="StrokeJoin" Value="Miter" />
    <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
