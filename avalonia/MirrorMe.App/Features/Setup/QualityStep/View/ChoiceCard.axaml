<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:MirrorMe.App.Controls"
                    xmlns:ti="using:TablerIcons"
                    xmlns:fields="using:MirrorMe.App.Features.Fields.ViewModel">

  <!--
    One entry of a question: its name, under it the price of picking it or what it was derived from,
    and what picking it raises as chips, each naming its sentence on hover.
    A refused card states its reason in the figure's place, so nothing opens over it
    (docs/tooltips.md, "Availability notes").
    The radio dot's treatment is a style of the view, a ControlTheme carrying no descendant selector.
  -->
  <DataTemplate x:Key="ChoiceCard" x:DataType="fields:OptionViewModel">
    <Button Theme="{StaticResource OptionCard}"
            Classes.picked="{Binding IsSelected}"
            IsEnabled="{Binding IsEnabled}"
            Command="{Binding Choose}">
      <StackPanel Spacing="3">
        <!-- A grid: a horizontal stack measures against infinite width, and the name would run past the edge. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Grid.Column="0" Classes="radiodot" />
          <TextBlock Grid.Column="1"
                     Classes="cardtitle"
                     Text="{Binding Label}"
                     Margin="7,0,0,0"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     VerticalAlignment="Center" />
        </Grid>
        <TextBlock Classes="hint"
                   Margin="20,0,0,0"
                   FontFeatures="{StaticResource FigureFeatures}"
                   IsVisible="{Binding !HasReason}"
                   Text="{Binding Figure}" />
        <SelectableTextBlock Classes="reason"
                             Margin="20,0,0,0"
                             IsVisible="{Binding HasReason}"
                             Text="{Binding Reason}" />
        <ItemsControl Margin="20,0,0,0"
                      IsVisible="{Binding HasImpacts}"
                      ItemsSource="{Binding Impacts}"
                      ItemsPanel="{StaticResource ChipPanel}"
                      ItemTemplate="{StaticResource ImpactChip}" />
      </StackPanel>
    </Button>
  </DataTemplate>

</ResourceDictionary>
