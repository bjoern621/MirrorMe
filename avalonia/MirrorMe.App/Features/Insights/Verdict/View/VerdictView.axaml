<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MirrorMe.App.Controls"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:MirrorMe.App.Features.Insights.Verdict.ViewModel"
             x:Class="MirrorMe.App.Features.Insights.Verdict.View.VerdictView"
             x:DataType="vm:VerdictViewModel">

  <UserControl.Styles>
    <Style Selector="Border.verdict">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
      <Setter Property="Transitions">
        <Transitions>
          <controls:BrushFade Property="BorderBrush" Duration="{StaticResource MotionMark}" Easing="{StaticResource MotionEase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.verdict.caution">
      <Setter Property="BorderBrush" Value="{StaticResource CautionBrush}" />
    </Style>
    <Style Selector="Border.verdict.stopped">
      <Setter Property="BorderBrush" Value="{StaticResource AttentionBrush}" />
    </Style>
    <Style Selector="ti|TablerIcon.verdict">
      <Setter Property="Brush" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="ti|TablerIcon.verdict.caution">
      <Setter Property="Brush" Value="{StaticResource CautionBrush}" />
    </Style>
    <Style Selector="ti|TablerIcon.verdict.stopped">
      <Setter Property="Brush" Value="{StaticResource AttentionBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- The cause and the pipeline's words report a failure, so both select and wrap. -->
  <Border Classes="verdict"
          Classes.caution="{Binding IsCaution}"
          Classes.stopped="{Binding IsStopped}"
          Padding="14,12">
    <Grid ColumnDefinitions="Auto,*">
      <ti:TablerIcon Grid.Column="0"
                     Classes="verdict"
                     Classes.caution="{Binding IsCaution}"
                     Classes.stopped="{Binding IsStopped}"
                     VerticalAlignment="Top"
                     Margin="0,1,10,0"
                     Icon="{Binding Glyph}" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Classes="heading" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Headline}" />
        <SelectableTextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Detail}" />
        <SelectableTextBlock Classes="transcript hint"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasMessage}"
                             Text="{Binding Message}" />
        <Button Theme="{StaticResource LinkButton}"
                HorizontalAlignment="Left"
                IsVisible="{Binding HasLog}"
                Content="{Binding OpenLogLabel}"
                Command="{Binding OpenLogCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
