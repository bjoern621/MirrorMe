<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:MirrorMe.App.Controls"
                    xmlns:ti="using:TablerIcons"
                    xmlns:view="using:MirrorMe.App.Features.Fields.View"
                    xmlns:vm="using:MirrorMe.App.Features.Fields.ViewModel">

  <!--
    Picture glyph beside a control's name, opening the comparison on hover and on a press,
    the press serving a touch screen. The pictures appear here alone,
    so the cards stay one line of name and one of figure.
  -->

  <!-- Heading, where to look, and one picture per entry with its name and figure. The held entry's is outlined. -->
  <DataTemplate x:Key="ComparisonTip" x:DataType="vm:ComparisonViewModel">
    <StackPanel Spacing="{StaticResource GapTight}">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBlock Classes="tipbody" Text="{Binding Sentence}" />
      <ItemsControl ItemsSource="{Binding Pictures}" Margin="0,5,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" ColumnSpacing="{StaticResource GapControl}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PictureViewModel">
            <StackPanel Spacing="{StaticResource GapTight}">
              <Border Classes="crop" Classes.picked="{Binding IsPicked}">
                <Image Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="None"
                       Source="{Binding Asset, Converter={x:Static controls:AssetBitmapConverter.Instance}}" />
              </Border>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="cropcaption" Classes.picked="{Binding IsPicked}" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="cropcaption" Classes.picked="{Binding IsPicked}" Text="{Binding Figure}" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="ComparisonGlyph" x:DataType="vm:FieldViewModel">
    <view:ComparisonButton Theme="{StaticResource IconButton}"
                           Width="24"
                           Height="24"
                           VerticalAlignment="Center">
      <ToolTip.Tip>
        <ToolTip Classes="pictures">
          <ContentControl Width="356" Content="{Binding Comparison}" ContentTemplate="{StaticResource ComparisonTip}" />
        </ToolTip>
      </ToolTip.Tip>
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft">
          <ContentControl Width="356" Content="{Binding Comparison}" ContentTemplate="{StaticResource ComparisonTip}" />
        </Flyout>
      </Button.Flyout>
      <ti:TablerIcon Icon="IconPhoto" Brush="{StaticResource MutedBrush}" />
    </view:ComparisonButton>
  </DataTemplate>

</ResourceDictionary>
