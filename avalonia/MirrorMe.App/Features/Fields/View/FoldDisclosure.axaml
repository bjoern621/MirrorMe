<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:MirrorMe.App.Controls"
                    xmlns:ti="using:TablerIcons"
                    xmlns:vm="using:MirrorMe.App.Features.Fields.ViewModel">

  <!--
    The press opening a step's fold: chevron, title, how many controls stand behind it,
    and the mark of what they raise, which a closed fold would otherwise hide.
  -->
  <DataTemplate x:Key="FoldDisclosure" x:DataType="vm:FoldViewModel">
    <Button Theme="{StaticResource LinkButton}"
            HorizontalAlignment="Left"
            Command="{Binding ToggleCommand}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ti:TablerIcon Classes="disclosure" Classes.open="{Binding Shown}" Icon="IconChevronRight" Brush="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock Classes="secondary" Text="{Binding Title}" VerticalAlignment="Center" />
        <TextBlock Classes="hint" Text="{Binding Count}" VerticalAlignment="Center" />
        <ti:TablerIcon Classes="impact"
                       Classes.warns="{Binding ImpactWarns}"
                       Classes.blocks="{Binding ImpactBlocks}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasImpacts}"
                       Icon="{Binding ImpactState, Converter={x:Static controls:CheckGlyphConverter.Instance}}"
                       ToolTip.Tip="{Binding ImpactTip}" />
      </StackPanel>
    </Button>
  </DataTemplate>

</ResourceDictionary>
