<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:MirrorMe.App.Controls">

  <!-- Every fold opens and closes on one motion (docs/design-language.md, "Motion"). -->
  <ControlTheme x:Key="{x:Type controls:Reveal}" TargetType="controls:Reveal">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Openness" Duration="{StaticResource MotionFold}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
